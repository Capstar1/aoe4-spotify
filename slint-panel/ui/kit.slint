// Small building blocks shared by the panel pages (1.0.9 / 1.1 drawing primitives as Slint components).
export global Pal {
    out property <color> bg: #121212;
    out property <color> card: #1f1f1f;
    out property <color> tx: #f2f2f2;
    out property <color> mu: #9a9a9a;
    out property <color> off: #3a3a3a;
    out property <color> line: #2a2a2a;
    out property <color> ib: #2a2a2a;
    out property <color> idle: #8a8a8a;
    out property <color> red: #e5484d;
    out property <color> green: #1DB954;
    out property <color> grey-acc: #6e6e6e;
    out property <color> dis: #555555;
    out property <color> org: #f0a030;
    out property <color> gold: #e0b040;
}

// ---- tooltips (1.1 tipOn / .gtip): hover 350 ms (instant when another just closed), below the area if it fits, else above
export global Tips {
    in-out property <string> text;
    in-out property <length> x0; in-out property <length> y0; in-out property <length> x1; in-out property <length> y1;
    in-out property <bool> pending;
    in-out property <bool> shown;
    in-out property <int> key;
    public function request(t: string, ax: length, ay: length, w: length, h: length) {
        self.text = t; self.x0 = ax; self.y0 = ay; self.x1 = ax + w; self.y1 = ay + h; self.key += 1;
        if (self.shown) { self.shown = true; } else { self.pending = true; }
    }
    public function hide() { self.pending = false; self.shown = false; }
}
// A TouchArea that shows a tooltip while hovered.
export component TipArea inherits TouchArea {
    in property <string> tip;
    changed has-hover => { if (self.has-hover && tip != "") { Tips.request(tip, self.absolute-position.x, self.absolute-position.y, self.width, self.height); } else if (!self.has-hover) { Tips.hide(); } }
    pointer-event(e) => { if (e.kind == PointerEventKind.down) { Tips.hide(); } }
}
// The tooltip bubble; place once per window, on top. `ww`/`wh`: window client size.
export component TipLayer inherits Rectangle {
    in property <length> ww; in property <length> wh;
    m1 := Text { visible: false; text: Tips.text; font-size: 12px; font-weight: 700; }
    m2 := Text { visible: false; width: 236px; text: Tips.text; font-size: 12px; font-weight: 700; wrap: word-wrap; }
    property <length> tw: min(260px, m1.preferred-width + 24px);
    property <length> th: (m1.preferred-width + 24px > 260px ? m2.preferred-height : m1.preferred-height) + 14px;
    property <bool> below: Tips.y1 + 6px + th + 6px <= wh;
    property <length> cx: (Tips.x0 + Tips.x1) / 2;
    property <length> left: min(max(4px, cx - tw / 2), ww - 4px - tw);
    x: 0; y: 0; width: ww; height: wh;
    Timer { interval: 350ms; running: Tips.pending; triggered => { Tips.pending = false; Tips.shown = true; } }
    if Tips.shown: Rectangle {
        x: left; y: below ? Tips.y1 + 12px : Tips.y0 - 12px - th; width: tw; height: th;
        // arrow
        Path { x: cx - left - 6px; y: below ? -6px : th; width: 12px; height: 6px; fill: #242426f6;
            commands: below ? "M 0 6 L 6 0 L 12 6 Z" : "M 0 0 L 6 6 L 12 0 Z"; }
        Rectangle { border-radius: 8px; background: #242426f6; border-width: 1px; border-color: #ffffff1f; drop-shadow-blur: 10px; drop-shadow-offset-y: 3px; drop-shadow-color: #00000078; }
        tt := Text { x: 12px; y: 7px; width: tw - 24px; text: Tips.text; font-size: 12px; font-weight: 700; color: #f2f2f2; wrap: word-wrap; horizontal-alignment: center; }
    }
}

// Text centred vertically on `cy` (the 1.0.9 canvas convention); anchor: left at x, or right edge at x when `right`.
export component Label inherits Text {
    in property <length> cy;
    in property <length> ax;
    in property <bool> right;
    in property <bool> centre;
    in property <bool> bold;
    font-weight: bold ? 700 : 400;
    vertical-alignment: center;
    height: 24px;
    y: cy - 12px;
    x: right ? ax - self.width : centre ? ax - self.width / 2 : ax;
    width: self.preferred-width;
}

// Single-colour icon (1.0.9 render used as a mask).
export component Icon inherits Image {
    in property <color> tint;
    colorize: tint;
    image-rendering: smooth;
}

// 1.0.9 toggle: pill + white knob; hover tints the plate.
export component Toggle inherits Rectangle {
    in property <bool> on;
    in property <color> acc: Pal.green;
    in property <bool> enabled: true;
    callback toggled();
    width: 44px;
    height: 24px;
    border-radius: self.height / 2;
    background: on ? acc : Pal.off;
    Rectangle {
        x: on ? parent.width - parent.height + 3px : 3px;
        y: 3px;
        width: parent.height - 6px;
        height: parent.height - 6px;
        border-radius: self.height / 2;
        background: white;
    }
    Rectangle { border-radius: parent.border-radius; background: ta.has-hover && root.enabled ? #ffffff1a : transparent; }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.toggled(); } }
}

// 1.0.9 revert (undo) pill: greyed when already the default.
export component Revert inherits Rectangle {
    in property <bool> is-default;
    callback reverted();
    width: 30px;
    height: 24px;
    border-radius: 12px;
    border-width: 1px;
    border-color: is-default ? Pal.dis : ta.has-hover ? Pal.tx : Pal.mu;
    background: !is-default && ta.has-hover ? #2e2e2e : Pal.card;
    Icon {
        x: 5px; y: 2px; width: 20px; height: 20px;
        source: is-default ? @image-url("../../ui/img/mk_undo_dis@1.png") : @image-url("../../ui/img/mk_undo_mu@1.png");
        tint: is-default ? Pal.dis : ta.has-hover ? Pal.tx : Pal.mu;
    }
    ta := TipArea { tip: is-default ? "Revert (already default)" : "Revert"; mouse-cursor: is-default ? default : pointer; clicked => { if (!is-default) { root.reverted(); } } }
}

// 24 px cover slot (After match), or the empty '+' slot.
export component Slot inherits Rectangle {
    in property <string> tip;
    in property <image> img;
    in property <bool> has-cover;
    callback picked();
    width: 26px;
    height: 26px;
    border-radius: 6px;
    border-width: ta.has-hover ? 1.5px : 0px;
    border-color: Pal.green;
    Rectangle {
        x: 1px; y: 1px; width: 24px; height: 24px; border-radius: 5px; clip: true; background: Pal.ib;
        if has-cover: Image { width: 24px; height: 24px; source: img; image-fit: cover; }
        if !has-cover: Icon { x: 1px; y: 1px; width: 22px; height: 22px; source: @image-url("../../ui/img/mk_am_plus@1.png"); tint: Pal.mu; }
    }
    ta := TipArea { tip: root.tip; mouse-cursor: pointer; clicked => { root.picked(); } }
}

